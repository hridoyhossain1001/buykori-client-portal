    "vercel-build": "vite build && node scripts/create-dashboard-route.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run test:routing && npm run test:analytics && npm run test:courier && npm run test:operations && npm run test:account && npm run test:account-ui && npm run test:locked-feature-ui && npm run test:ai-ads-ui && npm run test:ai-ads-api && npm run test:ai-ads-gate && npm run test:ai-ads-metrics && npm run test:ai-ads-review && npm run test:ai-ads-creative && npm run test:ai-ads-live && npm run test:ai-ads-connections && npm run test:ai-ads-chat && npm run test:ai-ads-chat-ui && npm run test:chat-markdown && npm run test:quota-format && npm run test:usage-panel && npm run test:error-state && npm run test:payment-ui && npm run test:http && npm run test:redact && npm run test:mock-api && npm run test:print && npm run test:campaign-payload && npm run test:design-tokens && npm run test:ui-contract && npm run test:tabs && npm run test:page-chrome && npm run test:dialogs && npm run test:primitive-styles && npm run test:overlay-controls && npm run test:product-thumb && npm run test:whatsapp && npm run test:whatsapp-ui && npm run test:whatsapp-cell && npm run test:orders-unified && npm run test:order-drawer",
