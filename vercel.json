{
  "version": 2,
  "cleanUrls": true,
  "framework": "vite",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-kwcHGvL63HQd7iVDh/8QzOalNVInFBpF4NVJkqmlBDQ='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "https://api.buykori.app/static/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.buykori.app/api/:path*"
    },
    {
      "source": "/plugin/connect",
      "destination": "/index.html"
    },
    {
      "source": "/client/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/client/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/order-success/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/client",
      "destination": "https://api.buykori.app/client"
    },
    {
      "source": "/client/login",
      "destination": "https://api.buykori.app/client/login"
    },
    {
      "source": "/client/signup",
      "destination": "https://api.buykori.app/client/signup"
    },
    {
      "source": "/client/forgot-password",
      "destination": "https://api.buykori.app/client/forgot-password"
    },
    {
      "source": "/client/reset-password",
      "destination": "https://api.buykori.app/client/reset-password"
    },
    {
      "source": "/client/verify-email",
      "destination": "https://api.buykori.app/client/verify-email"
    },
    {
      "source": "/client/logout",
      "destination": "https://api.buykori.app/client/logout"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
