.cod-panel .table-wrap td strong{display:block;font-size:12px;font-weight:600}.cod-panel .table-wrap td span{display:block;margin-top:3px;color:#71808a;font-size:11px;line-height:1.3}.cod-panel .cod-product-cell strong{color:#25323b}.cod-panel .table-wrap .amount{white-space:nowrap;color:#25323b;font-size:13px;font-weight:700;line-height:1.3}.cod-panel .cod-fraud-cell .p-badge{display:inline-flex;align-items:center;width:max-content;margin:0;vertical-align:middle;white-space:nowrap;font-size:11px;line-height:1}.cod-panel .fraud-reason{max-width:154px;margin-top:5px!important;color:#8b6b21!important;font-size:10px!important;line-height:1.25!important}.cod-panel .cod-waiting-cell{white-space:nowrap;color:#53616a;font-size:11px;font-weight:500}.cod-panel .row-actions{display:flex;align-items:center;gap:6px;white-space:nowrap}.cod-panel .row-actions .p-button{width:auto;min-height:36px;padding-inline:10px}.cod-panel .row-actions .p-button:first-child{flex:1 1 auto}.cod-panel .row-actions .p-button:last-child{flex:0 0 auto}
