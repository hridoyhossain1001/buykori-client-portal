@media(max-width:760px){.health-list-summary{align-items:flex-start;flex-wrap:wrap;gap:5px 16px;padding:11px 14px}.health-list-summary small{width:100%;margin-left:0}.health-list-header{display:none}.setup-health-panel .health-list article{grid-template-columns:38px minmax(0,1fr);gap:10px;padding:14px}.health-issue-copy{grid-column:2}.health-impact{grid-column:1/-1;padding:10px 0 0;border-top:1px solid #edf0f1;border-left:0}.health-impact p{max-width:none!important}.health-actions{grid-column:1/-1;grid-template-columns:1fr 1fr}.health-actions .p-button{min-height:42px}.setup-health-panel .health-list article h3{font-size:13px}}

