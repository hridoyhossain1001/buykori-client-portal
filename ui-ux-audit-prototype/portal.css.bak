/* Orders table: fixed lanes prevent long product/status copy from colliding with totals. */
.orders-panel .table-wrap{overflow-x:auto}
.orders-panel .table-wrap table{width:100%;min-width:1120px;table-layout:fixed;border-collapse:collapse}
.orders-panel .table-wrap th,.orders-panel .table-wrap td{padding:14px 12px;vertical-align:middle;line-height:1.35;white-space:normal}
.orders-panel .table-wrap th{color:#64727c;font-size:11px;font-weight:700;letter-spacing:.02em;text-transform:uppercase;text-align:left}
.orders-panel .table-wrap tbody tr{min-height:72px}
.orders-panel .table-wrap tbody tr:hover{background:#f8faf9}
.orders-panel .table-wrap th:nth-child(1),.orders-panel .table-wrap td:nth-child(1){width:42px;padding-inline:14px}
.orders-panel .table-wrap th:nth-child(2),.orders-panel .table-wrap td:nth-child(2){width:96px}
.orders-panel .table-wrap th:nth-child(3),.orders-panel .table-wrap td:nth-child(3){width:155px}
.orders-panel .table-wrap th:nth-child(4),.orders-panel .table-wrap td:nth-child(4){width:190px}
.orders-panel .table-wrap th:nth-child(5),.orders-panel .table-wrap td:nth-child(5){width:112px}
.orders-panel .table-wrap th:nth-child(6),.orders-panel .table-wrap td:nth-child(6){width:108px}
.orders-panel .table-wrap th:nth-child(7),.orders-panel .table-wrap td:nth-child(7){width:150px}
.orders-panel .table-wrap th:nth-child(8),.orders-panel .table-wrap td:nth-child(8){width:94px}
.orders-panel .table-wrap th:nth-child(9),.orders-panel .table-wrap td:nth-child(9){width:84px}
.orders-panel .table-wrap th:nth-child(10),.orders-panel .table-wrap td:nth-child(10){width:46px;padding-inline:8px}
.orders-panel .table-wrap td strong{display:block;font-size:12px;font-weight:600;line-height:1.35}
.orders-panel .table-wrap td span{display:block;margin-top:4px;color:#71808a;font-size:11px;line-height:1.35}
.orders-panel .table-wrap .order-product-cell strong{color:#25323b}
.orders-panel .table-wrap .amount{white-space:nowrap;font-size:12px}
.orders-panel .table-wrap .p-badge{white-space:nowrap}
.orders-panel .view-tabs{padding-inline:14px}
.orders-panel .toolbar{padding:13px 14px}
.orders-panel .toolbar-actions{gap:8px}
.orders-panel .toolbar-actions .compact-select{min-width:132px}
@media(max-width:1100px) and (min-width:761px){.orders-panel .table-wrap table{min-width:1080px}.orders-panel .table-wrap th,.orders-panel .table-wrap td{padding-inline:9px}}
@media(max-width:760px){.orders-panel .view-tabs{padding-inline:14px}.orders-panel .mobile-order-list article{min-height:142px;padding:16px}.orders-panel .mobile-order-list article p{margin:14px 0}.orders-panel .mobile-order-list article footer{font-size:11px}}

/* Shared type scale: keep operational content readable and predictable across routes. */
:root{--type-caption:12px;--type-body:14px;--type-label:11px;--type-section:16px;--type-metric:24px;--type-title:30px}
body{font-size:var(--type-body)}
.page-heading h1{font-size:var(--type-title);font-weight:700}
.page-heading p:not(.eyebrow){font-size:var(--type-body);line-height:1.5}
.eyebrow{font-size:var(--type-label);letter-spacing:.02em}
.section-title h2{font-size:var(--type-section);font-weight:600}
.section-title p{font-size:var(--type-caption);line-height:1.45}
.metric-strip span{font-size:var(--type-label);letter-spacing:.02em}
.metric-strip strong{font-size:var(--type-metric);font-weight:700}
.metric-strip small{font-size:var(--type-caption);line-height:1.4}
.action-list strong{font-size:13px;font-weight:600}
.action-list small{font-size:var(--type-caption);line-height:1.4}
.platform-rows button strong{font-size:13px;font-weight:600}
.platform-rows button>span,.platform-rows button small{font-size:var(--type-caption)}
.portal-nav p{font-size:var(--type-label);letter-spacing:.02em}
.portal-nav button span:nth-child(2){font-size:13px}
.portal-nav button b{font-size:var(--type-label)}
.brand-row strong{font-size:16px}.brand-row span{font-size:var(--type-label)}
.store-switch small{font-size:var(--type-label)}.store-switch strong{font-size:13px}.store-switch em{font-size:var(--type-caption)}
.usage-mini>span{font-size:var(--type-label)}.usage-mini>strong{font-size:13px}.usage-mini>strong small{font-size:var(--type-caption)}
.profile-chip strong{font-size:13px}.profile-chip small{font-size:var(--type-caption)}
.crumbs{font-size:var(--type-caption)}
.workspace-search span{font-size:var(--type-label)}
.p-button{font-size:var(--type-label)}
.table-wrap table{font-size:var(--type-caption)}
.table-wrap td strong,.table-wrap th{font-size:var(--type-caption)}
.table-wrap td span{font-size:var(--type-label)}
.notice-bar strong{font-size:var(--type-caption)}.notice-bar small{font-size:var(--type-label)}
.p-badge{font-size:var(--type-label)}
.order-drawer h2{font-size:21px}.order-drawer h3{font-size:var(--type-label)}
.order-drawer section,.order-drawer footer{font-size:var(--type-caption)}
@media(max-width:760px){.page-heading h1{font-size:26px}.page-heading p:not(.eyebrow){font-size:13px}.section-title h2{font-size:15px}.metric-strip strong{font-size:20px}.action-list strong{font-size:13px}.action-list small{font-size:var(--type-label)}.portal-nav button span:nth-child(2){font-size:13px}}
.compact-select{display:flex;align-items:center;gap:6px;height:38px;padding:0 9px;color:#697780;background:#fff;border:1px solid #d7dcdf;border-radius:6px;font-size:10px;font-weight:700}.compact-select select{min-width:96px;height:34px;padding:0 2px;color:#53616a;background:transparent;border:0;font-size:10px;font-weight:700;outline:0}.inline-preview-feedback{display:flex;align-items:center;gap:8px;margin:0 20px 12px;padding:10px 12px;color:#276a5a;background:#eef8f4;border:1px solid #cfe9df;border-radius:6px;font-size:10px;font-weight:700}.drawer-actions{display:flex;flex-wrap:wrap;gap:8px}.drawer-actions .p-button{flex:1;min-width:120px}
@media(max-width:760px){.orders-panel .toolbar-actions{grid-template-columns:1fr 1fr}.compact-select{min-width:0}.compact-select select{width:100%;min-width:0}.inline-preview-feedback{margin-inline:14px}.drawer-actions{display:grid;grid-template-columns:1fr 1fr}.drawer-actions .p-button{min-width:0}.drawer-actions .p-button:last-child{grid-column:1/3}}
.cod-settings-sheet section{padding:0}.cod-settings-sheet .setting-row{min-height:76px}.cod-setting-field{display:grid;gap:7px;padding:18px 20px;border-bottom:1px solid var(--line)}.cod-setting-field label{display:grid;gap:7px;color:#53606b;font-size:10px;font-weight:800}.cod-setting-field select{height:38px;padding:0 10px;color:#27343d;background:#fff;border:1px solid #d7dcdf;border-radius:6px;font-size:11px}.cod-setting-field small{color:#7b8790;font-size:9px;line-height:1.5}.cod-settings-sheet>footer{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:auto;padding:14px 20px;border-top:1px solid var(--line)}.mobile-order-list article>footer{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:11px;padding-top:10px;color:#78848c;border-top:1px solid #edf0f1;font-size:9px}.mobile-order-list article>footer .p-button{min-height:38px}
.recovery-list article{position:relative}.recovery-list article.selected{background:#f1f8f6}.recovery-actions{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:7px;padding:10px 0 2px;border-top:1px solid #edf0f1}.recovery-actions .p-button{min-height:38px}.queue-count{align-self:center;color:#7b8790;font-size:10px;font-weight:700}.recovery-sheet .recovery-note{width:100%;min-height:90px;padding:10px;color:#46555d;background:#fff;border:1px solid #d7dcdf;border-radius:6px;font:inherit;font-size:11px;resize:vertical}.inline-number{width:44px;height:25px;margin-left:4px;padding:0 4px;border:1px solid #d7dcdf;border-radius:4px;font-size:10px}.confirm-overlay{position:fixed;inset:0;z-index:70;display:grid;place-items:center;padding:20px;background:rgba(17,28,36,.35)}.confirm-dialog{width:min(380px,100%);padding:22px;background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:0 15px 45px rgba(25,39,51,.2)}.confirm-dialog h2{margin:0;font-size:17px}.confirm-dialog p{margin:8px 0 18px;color:#71808a;font-size:11px;line-height:1.5}.confirm-dialog>div{display:flex;justify-content:flex-end;gap:8px}
.toggle-label{display:flex;align-items:center;gap:7px;color:#53616a;font-size:10px;font-weight:700}.toggle-label input{accent-color:var(--accent)}.detail-list{display:grid;gap:10px}.detail-list div{display:flex;justify-content:space-between;gap:12px;padding-bottom:9px;border-bottom:1px solid #edf0f1}.detail-list span{color:#7b8790;font-size:10px}.detail-list strong{font-size:10px;text-align:right}.detail-copy{margin:0;color:#71808a;font-size:10px;line-height:1.7}
.analytics-feedback{position:fixed;right:22px;bottom:22px;z-index:30;margin:0}.tester-history,.data-preview-grid{margin:18px 20px 20px;padding-top:12px;border-top:1px solid var(--line)}.tester-history>div{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #edf0f1;color:#64727a;font-size:10px}.data-preview-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.data-preview-grid div{padding:12px;background:#f7faf9;border:1px solid #e1ebe8;border-radius:6px}.data-preview-grid span,.data-preview-grid strong{display:block}.data-preview-grid span{color:#7b8790;font-size:9px}.data-preview-grid strong{margin-top:6px;font-size:11px}.campaigns{position:relative}
@media(max-width:760px){.analytics-feedback{right:14px;bottom:14px}.data-preview-grid{grid-template-columns:1fr 1fr}.tester-history{margin-inline:14px}}
@media(max-width:760px){.recovery-actions{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr}.recovery-actions .p-button:last-child{grid-column:1/-1}.confirm-dialog>div{display:grid;grid-template-columns:1fr}.recovery-sheet>footer{grid-template-columns:1fr 1fr}}
.account-feedback{position:fixed;right:22px;bottom:22px;z-index:30;margin:0}.settings-content .inline-preview-feedback{margin-inline:20px}.settings-content .setting-row .toggle,.settings-content .alert-channel .p-button{min-height:44px}@media(max-width:760px){.account-feedback{right:14px;bottom:14px}.settings-content .inline-preview-feedback{margin-inline:14px}}

/* Incomplete checkout queue: compact scanning columns with visible primary actions. */
.incomplete-panel .section-title{padding-bottom:14px}.incomplete-panel .toolbar{padding-block:12px}.incomplete-table-wrap{overflow-x:auto}.incomplete-table{width:100%;min-width:920px;table-layout:fixed;border-collapse:collapse}.incomplete-table th,.incomplete-table td{padding:11px 9px;vertical-align:middle;text-align:left;border-top:1px solid #edf0f1}.incomplete-table th{height:40px;color:#64727c;font-size:11px;font-weight:700;letter-spacing:.02em;text-transform:uppercase}.incomplete-table tbody tr{height:74px}.incomplete-table tbody tr:hover{background:#f8faf9}.incomplete-table th:nth-child(1),.incomplete-table td:nth-child(1){width:180px;padding-left:16px}.incomplete-table th:nth-child(2),.incomplete-table td:nth-child(2){width:145px}.incomplete-table th:nth-child(3),.incomplete-table td:nth-child(3){width:88px}.incomplete-table th:nth-child(4),.incomplete-table td:nth-child(4){width:82px}.incomplete-table th:nth-child(5),.incomplete-table td:nth-child(5){width:76px}.incomplete-table th:nth-child(6),.incomplete-table td:nth-child(6){width:112px}.incomplete-table th:nth-child(7),.incomplete-table td:nth-child(7){width:237px;padding-right:16px}.incomplete-table td strong,.incomplete-table td span,.incomplete-table td small{display:block}.incomplete-table td strong{color:#25323b;font-size:12px;font-weight:600;line-height:1.3}.incomplete-table td span{margin-top:3px;color:#65737d;font-size:11px;line-height:1.25}.incomplete-table td small{margin-top:3px;color:#87929a;font-size:10px;line-height:1.25}.incomplete-table .p-badge{display:inline-flex;width:max-content;margin:0;font-size:10px}.checkout-amount{white-space:nowrap;color:#25323b;font-size:12px;font-weight:700}.checkout-time{white-space:nowrap;color:#53616a;font-size:11px;font-weight:600}.checkout-status{width:104px;height:36px;padding:0 26px 0 9px;color:#4e5d66;background:#f2f4f5;border:1px solid #dce1e3;border-radius:6px;font-size:10px;font-weight:700;outline:0}.checkout-status.active{color:#176b5b;background:#edf8f4;border-color:#cce8df}.checkout-status.contacted{color:#315b8a;background:#eff5fb;border-color:#d6e3f0}.checkout-status.recovered{color:#276a5a;background:#e8f5ef;border-color:#c8e4d8}.checkout-actions{display:flex;align-items:center;justify-content:flex-end;gap:6px;white-space:nowrap}.checkout-actions .p-button{min-height:36px;padding-inline:8px;font-size:10px}.incomplete-mobile-list{display:none}.mobile-checkout-status{display:flex;align-items:center;justify-content:space-between;gap:12px}.mobile-checkout-status>span{color:#6d7a83;font-size:11px;font-weight:700}
@media(max-width:1100px) and (min-width:761px){.incomplete-table th,.incomplete-table td{padding-inline:9px}.incomplete-table th:nth-child(1),.incomplete-table td:nth-child(1){padding-left:14px}.incomplete-table th:nth-child(7),.incomplete-table td:nth-child(7){padding-right:14px}}
@media(max-width:760px){.incomplete-panel .section-title{display:grid;grid-template-columns:1fr;gap:10px}.incomplete-panel .section-title .compact-select,.incomplete-panel .section-title .compact-select select{width:100%}.incomplete-mobile-list{display:grid}.incomplete-mobile-list article{min-height:0}.incomplete-mobile-list article p{display:grid;gap:4px;margin:12px 0}.incomplete-mobile-list article p strong{font-size:13px}.incomplete-mobile-list article p span{margin:0;font-size:11px}.incomplete-mobile-list article footer{display:grid;grid-template-columns:1fr 1fr;gap:7px}.incomplete-mobile-list article footer .p-button{width:100%;min-width:0;padding-inline:7px}.mobile-checkout-status{padding:10px 0;border-top:1px solid #edf0f1}.checkout-status{height:40px}}

/* Event activity follows the production event-log hierarchy without stretched rows. */
.event-activity-panel,.event-activity-panel button,.event-activity-panel input{font-family:Inter,Arial,sans-serif}.event-activity-panel{overflow:hidden}.event-filter-toolbar{display:flex;align-items:center;gap:12px;padding:14px 16px}.event-filter-toolbar .field-search{flex:1;max-width:none}.event-live-control{min-width:192px;display:grid;grid-template-columns:1fr 36px;grid-template-rows:auto auto;align-items:center;gap:2px 10px;padding:8px 10px;color:#68757e;text-align:left;background:#f7f9f9;border:1px solid #dfe4e6;border-radius:7px}.event-live-control>span{display:flex;align-items:center;gap:7px;color:#34424b;font-size:var(--type-label);font-weight:700;line-height:1.35}.event-live-control>span>i{width:7px;height:7px;border-radius:50%;background:#9aa5ac}.event-live-control>small{font-size:10px;line-height:1.35}.event-live-control>b{grid-column:2;grid-row:1/3;width:34px;height:20px;padding:2px;background:#d8dee1;border-radius:12px}.event-live-control>b i{display:block;width:16px;height:16px;background:#fff;border-radius:50%;box-shadow:0 1px 2px rgba(23,33,43,.18);transition:.15s}.event-live-control.active{background:#f0f8f5;border-color:#cde6de}.event-live-control.active>span>i{background:#2fa47f}.event-live-control.active>b{background:var(--accent)}.event-live-control.active>b i{transform:translateX(14px)}.event-filter-chips{display:flex;align-items:center;gap:7px;padding:10px 16px;overflow-x:auto;border-top:1px solid #edf0f1;border-bottom:1px solid #edf0f1;scrollbar-width:none}.event-filter-chips::-webkit-scrollbar{display:none}.event-filter-chips button{min-height:32px;display:inline-flex;align-items:center;gap:6px;flex:0 0 auto;padding:0 11px;color:#62707a;background:#fff;border:1px solid #dfe4e6;border-radius:16px;font-size:var(--type-label);font-weight:700;line-height:1.35}.event-filter-chips button span{color:#8a959d;font-size:10px}.event-filter-chips button:hover{background:#f6f8f8}.event-filter-chips button.active{color:#315b8a;background:#eff5fb;border-color:#cbdced}.event-filter-chips button.active.all{color:#fff;background:#24333e;border-color:#24333e}.event-filter-chips button.active.delivered{color:#176b5b;background:#edf8f4;border-color:#c9e7dd}.event-filter-chips button.active.failed{color:#a2231b;background:#fff1ef;border-color:#f1cbc6}.event-filter-chips button.active.retrying{color:#805500;background:#fff7df;border-color:#eddaa0}.event-filter-chips .event-clear-filter{margin-left:auto;color:#315b8a;border-color:transparent}.event-filter-divider{width:1px;height:20px;flex:0 0 auto;background:#dfe4e6}.event-results-bar{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 16px}.event-results-bar>span{color:#34424b;font-size:var(--type-caption);font-weight:700;line-height:1.4}.event-results-bar small{color:#7a8790;font-size:var(--type-label);line-height:1.4}.event-list-header,.event-list button{display:grid;grid-template-columns:100px 160px minmax(190px,1fr) 270px 66px;align-items:center;gap:12px;padding-inline:16px}.event-list-header{min-height:38px;color:#687680;background:#f8faf9;border-top:1px solid #edf0f1;border-bottom:1px solid #e5e9ea;font-size:var(--type-label);font-weight:700;line-height:1.35;text-transform:uppercase}.event-list button{min-height:72px;padding-block:10px}.event-list button:hover{background:#f8faf9}.event-list strong,.event-list small{display:block;font-family:inherit}.event-list strong{color:#25323b;font-size:var(--type-caption);font-weight:600;line-height:1.4}.event-list small{margin-top:3px;color:#7b8790;font-size:var(--type-label);line-height:1.4}.event-time strong{font-size:var(--type-caption)}.event-time small{font-size:var(--type-label)}.event-name-cell small{font-family:inherit}.event-context{min-width:0}.event-context strong,.event-context small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.event-delivery{display:flex;align-items:center}.event-delivery .event-destinations{display:flex;flex-wrap:wrap;gap:5px;max-width:none}.event-destination-result{display:inline-flex;margin:0!important}.event-delivery .event-destinations .p-badge{margin:0;font-size:10px;line-height:1.2}.event-view{display:flex;align-items:center;justify-content:flex-end;gap:3px;color:#315b8a;font-size:var(--type-label);font-weight:700;line-height:1.35}.event-list-footer{min-height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;color:#7b8790;border-top:1px solid #edf0f1;font-size:var(--type-label);line-height:1.4}
@media(max-width:1100px) and (min-width:761px){.event-list-header,.event-list button{grid-template-columns:82px 140px minmax(170px,1fr) 235px 56px;gap:9px;padding-inline:12px}.event-delivery{gap:6px}}
@media(max-width:760px){.event-filter-toolbar{align-items:stretch;flex-direction:column;padding:12px 14px}.event-live-control{width:100%;min-width:0}.event-filter-chips{padding-inline:14px}.event-filter-divider{display:none}.event-results-bar{align-items:flex-start;flex-direction:column;gap:2px;padding:10px 14px}.event-list-header{display:none}.event-list button{min-height:96px;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"name time" "context context" "delivery delivery";gap:5px 12px;padding:12px 14px}.event-name-cell{grid-area:name;min-width:0}.event-time{grid-area:time;text-align:right}.event-time small{display:none}.event-context{grid-area:context}.event-delivery{grid-area:delivery;justify-content:flex-start;margin-top:3px}.event-view{display:none}.event-name-cell strong{font-size:13px}.event-context strong{font-size:11px}.event-list-footer{align-items:flex-start;flex-direction:column;gap:3px;padding:10px 14px}}

/* Delivery logs use fixed operational columns instead of a stretched free-form row. */
.delivery-panel,.delivery-panel button,.delivery-panel input,.delivery-panel select{font-family:Inter,Arial,sans-serif}.delivery-panel .section-title{padding-bottom:14px}.delivery-panel .provider-health{padding:0 16px 14px}.delivery-panel .provider-health>div{padding:10px 12px}.delivery-panel .provider-health strong{font-size:var(--type-caption);line-height:1.4}.delivery-panel .provider-health small{font-size:10px;line-height:1.4}.delivery-panel .provider-health .p-badge{font-size:10px}.delivery-toolbar{min-height:58px;padding:10px 16px}.delivery-toolbar .toggle-label{margin-left:4px}.delivery-toolbar .queue-count{margin-left:auto}.delivery-log-table-wrap{overflow-x:auto}.delivery-log-table{width:100%;min-width:860px;table-layout:fixed;border-collapse:collapse}.delivery-log-table th,.delivery-log-table td{padding:10px 12px;vertical-align:middle;text-align:left;border-top:1px solid #edf0f1}.delivery-log-table th{height:40px;color:#687680;background:#f8faf9;font-size:var(--type-label);font-weight:700;line-height:1.35;text-transform:uppercase}.delivery-log-table tbody tr{height:62px;cursor:pointer}.delivery-log-table tbody tr:hover{background:#f8faf9}.delivery-log-table th:nth-child(1),.delivery-log-table td:nth-child(1){width:13%;padding-left:16px}.delivery-log-table th:nth-child(2),.delivery-log-table td:nth-child(2){width:20%}.delivery-log-table th:nth-child(3),.delivery-log-table td:nth-child(3){width:25%}.delivery-log-table th:nth-child(4),.delivery-log-table td:nth-child(4){width:9%}.delivery-log-table th:nth-child(5),.delivery-log-table td:nth-child(5){width:10%}.delivery-log-table th:nth-child(6),.delivery-log-table td:nth-child(6){width:15%}.delivery-log-table th:nth-child(7),.delivery-log-table td:nth-child(7){width:8%;padding-right:16px;text-align:right}.delivery-log-table td{color:#43515a;font-size:var(--type-label);line-height:1.4}.delivery-log-table td strong,.delivery-log-table td span{font-family:inherit}.delivery-log-table td strong{color:#25323b;font-size:var(--type-caption);font-weight:600}.delivery-time strong,.delivery-time span{display:block}.delivery-time span{margin-top:3px;color:#839099;font-size:10px}.delivery-host{overflow:hidden;color:#53616a;text-overflow:ellipsis;white-space:nowrap}.delivery-log-table .method{display:inline-flex;align-items:center;min-height:24px;padding:0 7px;color:#315b8a;background:#edf4fb;border-radius:4px;font-size:10px;font-weight:700}.delivery-log-table .p-badge{font-size:10px}.delivery-retry{color:#805500;font-size:var(--type-label);font-weight:700}.delivery-retry.muted{color:#7d8991;font-weight:500}.delivery-log-table .icon-button{margin-left:auto}.delivery-mobile-list{display:none}.delivery-mobile-list .muted{color:#7d8991}
