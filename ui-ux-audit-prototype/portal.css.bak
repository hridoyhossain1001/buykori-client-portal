rong{font-size:var(--type-caption)}.area-share{display:grid;grid-template-columns:1fr 42px;align-items:center;gap:7px}.area-share i{height:6px}
@media(max-width:1100px) and (min-width:761px){.business-result-strip{grid-template-columns:repeat(3,1fr)}.business-result-strip>div:nth-child(3){border-right:0}.business-result-strip>div:nth-child(-n+3){border-bottom:1px solid #edf0f1}.customer-insight-grid{grid-template-columns:1fr 1fr}.customer-insight-grid>.p-panel:first-child{grid-column:1/-1}.ad-results-toolbar{grid-template-columns:1fr 160px auto}}
