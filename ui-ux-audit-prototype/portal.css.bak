/* Tracking settings: destinations, routes and custom event automations */
.telegram-link-preview{display:flex;align-items:center;justify-content:space-between;gap:15px;margin:0 20px 15px;padding:13px;color:#315b52;background:#f1f8f6;border:1px solid #d5eae4;border-radius:6px}.telegram-link-preview span,.telegram-link-preview strong,.telegram-link-preview small{display:block}.telegram-link-preview span{color:#71847f;font-size:9px;text-transform:uppercase}.telegram-link-preview strong{margin-top:4px;font:700 20px/1.1 Consolas,monospace;letter-spacing:2px}.telegram-link-preview small{margin-top:5px;color:#71847f;font-size:9px}.telegram-link-preview>div:last-child{display:flex;gap:7px}.alert-preference-row{min-height:68px;display:flex;align-items:center;gap:10px;padding:10px 20px;border-top:1px solid #edf0f1}.alert-preference-row>span:nth-child(2){min-width:0;flex:1}.alert-preference-row strong,.alert-preference-row small{display:block}.alert-preference-row strong{font-size:11px}.alert-preference-row small{margin-top:4px;color:#7b8790;font-size:9px;line-height:1.35}.alert-preference-icon{width:28px;height:28px;display:grid;place-items:center;color:#176b5b;background:#e8f4f1;border-radius:6px}.alert-preference-row:nth-last-child(-n+2) .alert-preference-icon{color:#7b8790;background:#f0f2f3}.alert-preference-row .p-badge{flex:0 0 auto}
.courier-logo-badge img{width:100%;height:100%;padding:4px;object-fit:contain;background:#fff;border:1px solid #e1e6e8;border-radius:6px}
.courier-provider-list{display:grid;gap:8px;padding:0 20px 20px}.courier-provider-card{overflow:hidden;border:1px solid #e1e6e8;border-radius:7px;background:#fff}.courier-provider-card.open{border-color:#a9d7ca;box-shadow:0 2px 7px rgba(25,90,76,.07)}.courier-provider-head{min-height:67px;display:flex;align-items:center;gap:10px;padding:10px 12px}.courier-logo-badge{width:34px;height:34px;display:grid;place-items:center;color:#315b8a;background:#edf4fb;border-radius:6px;font-size:13px;font-weight:800}.courier-provider-copy{min-width:0;flex:1}.courier-provider-copy strong,.courier-provider-copy small{display:block}.courier-provider-copy strong{font-size:11px}.courier-provider-copy small{margin-top:4px;color:#7b8790;font-size:9px}.courier-configure-button{display:inline-flex;align-items:center;gap:4px;min-height:32px;padding:0 8px;color:#176b5b;background:#f1f8f6;border:1px solid #d5eae4;border-radius:5px;font-size:10px;font-weight:700}.courier-credential-editor{padding:13px 14px 12px;background:#f8fbfa;border-top:1px solid #e1eee9}.courier-editor-help{display:flex;align-items:flex-start;gap:8px;padding:9px 10px;color:#315b52;background:#edf7f4;border:1px solid #d5eae4;border-radius:5px}.courier-editor-help strong,.courier-editor-help small{display:block}.courier-editor-help strong{font-size:10px}.courier-editor-help small{margin-top:3px;color:#668078;font-size:9px;line-height:1.4}.courier-field-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.courier-field-grid label,.courier-secret-field{display:grid;gap:5px;color:#65747c;font-size:9px;font-weight:800;text-transform:uppercase}.courier-field-grid input,.courier-secret-field input,.courier-callback-row input{height:36px;width:100%;padding:0 9px;color:#26343d;background:#fff;border:1px solid #d7dcdf;border-radius:5px;font:500 10px Inter,Arial,sans-serif}.courier-webhook-box{display:grid;gap:10px;margin-top:12px;padding:12px;background:#fff;border:1px solid #dfe9e6;border-radius:6px}.courier-webhook-box>div:first-child strong,.courier-webhook-box>div:first-child small{display:block}.courier-webhook-box>div:first-child strong{font-size:10px}.courier-webhook-box>div:first-child small{margin-top:3px;color:#7b8790;font-size:9px;line-height:1.35}.courier-callback-row{display:grid;grid-template-columns:1fr auto;align-items:end;gap:8px}.courier-callback-row label{display:grid;gap:5px;color:#65747c;font-size:9px;font-weight:800;text-transform:uppercase}.courier-callback-row button{height:36px;display:inline-flex;align-items:center;gap:5px;padding:0 9px;color:#176b5b;background:#f1f8f6;border:1px solid #cfe2dc;border-radius:5px;font-size:10px;font-weight:700}.courier-secret-field{max-width:360px}.courier-webhook-status{display:flex;align-items:center;gap:8px;color:#7b8790;font-size:9px}.courier-editor-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px;padding-top:10px;border-top:1px solid #e5ece9;color:#758780;font-size:9px}.courier-editor-footer span{display:flex;align-items:center;gap:5px}.courier-editor-footer button{min-height:32px;padding:0 9px;color:#176b5b;background:#fff;border:1px solid #cfe2dc;border-radius:5px;font-size:10px;font-weight:700}.courier-health-grid{padding-bottom:15px}
.event-add-control select{width:135px;height:34px;padding:0 8px;color:#26343d;background:#fff;border:1px solid #d7dcdf;border-radius:5px;font:500 10px Inter,Arial,sans-serif}.custom-event-actions{display:flex;gap:7px}.custom-event-example{display:flex;align-items:flex-start;gap:9px;margin:0 20px 14px;padding:11px 12px;color:#315b52;background:#f1f8f6;border:1px solid #d5eae4;border-radius:6px}.custom-event-example strong,.custom-event-example small{display:block}.custom-event-example strong{font-size:10px}.custom-event-example small{margin-top:3px;color:#71847f;font-size:9px}.custom-automation-list{display:grid;gap:10px;padding:0 20px 20px}.custom-automation-list article{padding:13px;background:#fafbfb;border:1px solid #e1e6e8;border-radius:7px}.custom-automation-list article.active{background:#fff;border-color:#d7e7e2}.custom-automation-list article>header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:11px;padding-bottom:10px;border-bottom:1px solid #edf0f1}.custom-automation-list article>header strong,.custom-automation-list article>header small{display:block}.custom-automation-list article>header strong{font-size:12px}.custom-automation-list article>header small{margin-top:4px;color:#7b8790;font-size:9px}.automation-primary-grid{display:grid;grid-template-columns:minmax(180px,1fr) 145px minmax(180px,1fr) 80px;gap:9px}.automation-primary-grid label,.automation-data-grid label{display:grid;gap:5px;color:#65747c;font-size:9px;font-weight:800;text-transform:uppercase}.automation-primary-grid input,.automation-primary-grid select,.automation-data-grid input{width:100%;height:36px;padding:0 9px;color:#26343d;background:#fff;border:1px solid #d7dcdf;border-radius:5px;font:500 10px Inter,Arial,sans-serif}.automation-manage{display:flex;align-items:end;justify-content:flex-end;gap:6px}.automation-manage>button:last-child{width:36px;height:36px;display:grid;place-items:center;color:#a23a32;background:#fff;border:1px solid #ead5d2;