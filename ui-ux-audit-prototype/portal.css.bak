-test-history>div>span small{margin-top:2px;color:#7b8790;font-size:10px}.campaign-preview-grid{grid-template-columns:minmax(0,1.4fr) minmax(300px,.6fr)}.campaign-preview-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:0 20px 14px}.campaign-preview-summary>div{padding:10px;background:#f7faf9;border:1px solid #e1ebe8;border-radius:6px}.campaign-preview-summary span,.campaign-preview-summary strong{display:block}.campaign-preview-summary span{color:#7b8790;font-size:9px}.campaign-preview-summary strong{margin-top:5px;font-size:11px;overflow-wrap:anywhere}.payload-preview{margin:0 20px 20px;overflow:hidden;color:#d8e4e1;background:#172229;border-radius:6px}.payload-preview header{height:40px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;color:#91a29f;border-bottom:1px solid #314047;font-size:9px;font-weight:700}.payload-preview header button{display:inline-flex;align-items:center;gap:5px;padding:6px 8px;color:#c5d2cf;background:#26343b;border:0;border-radius:4px;font-size:10px}.payload-preview pre{max-height:430px;margin:0;padding:14px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:10px/1.6 Consolas,monospace}.preview-check-list{margin:0 20px 16px}.preview-check-list>div{display:flex;align-items:flex-start;gap:9px;padding:12px 0;color:#176b5b;border-bottom:1px solid #edf0f1}.preview-check-list strong,.preview-check-list small{display:block}.preview-check-list strong{color:#35434c;font-size:11px}.preview-check-list small{margin-top:3px;color:#75828a;font-size:10px;line-height:1.4}.latest-delivery{margin:0 20px 18px;padding:13px;background:#f1f8f6;border:1px solid #d5eae4;border-radius:6px}.latest-delivery span,.latest-delivery strong,.latest-delivery small{display:block}.latest-delivery span{color:#71847f;font-size:9px}.latest-delivery strong{margin-top:5px;font-size:11px}.latest-delivery small{margin-top:3px;color:#71847f;font-size:10px}
@media(max-width:960px){.campaign-test-grid,.campaign-preview-grid{grid-template-columns:1fr}.campaign-response-panel{min-height:auto}}
@media(max-width:760px){.courier-provider-list{padding:0 14px 14px}.courier-provider-head{align-items:flex-start;flex-wrap:wrap;padding:11px}.courier-provider-copy{min-width:calc(100% - 45px);flex:1}.courier-provider-head>.p-badge{margin-left:45px}.courier-configure-button{margin-left:auto}.courier-field-grid{grid-template-columns:1fr;gap:9px}.courier-field-grid input,.courier-secret-field input,.courier-callback-row input{height:42px;font-size:12px}.courier-callback-row{grid-template-columns:1fr}.courier-callback-row button{width:100%;height:42px;justify-content:center}.courier-webhook-status{align-items:flex-start;flex-direction:column}.courier-editor-footer{align-items:flex-start;flex-direction:column}.courier-editor-footer button{width:100%;min-height:42px}}
@media(max-width:760px){.alert-channel{display:grid;grid-template-columns:34px 1fr auto;padding:12px 14px}.alert-channel>.p-button{grid-column:2/-1;width:100%;margin-top:6px}.telegram-link-preview{align-items:flex-start;flex-direction:column;margin-inline:14px}.telegram-link-preview>div:last-child{display:grid;width:100%;grid-template-columns:1fr 1fr}.telegram-link-preview .p-button{width:100%}.alert-preference-row{display:grid;grid-template-columns:28px 1fr auto;padding:12px 14px}.alert-preference-row>.toggle{grid-column:3;grid-row:2}.alert-preference-row>.p-badge{grid-column:2;justify-self:start}}
@media(max-width:760px){.store-connection-body{grid-template-columns:1fr}.store-domain-block,.store-heartbeat-block{padding:14px}.store-domain-block{border-right:0;border-bottom:1px solid #edf0f1}.store-inline-actions{align-items:flex-start;flex-direction:column}.store-inline-actions .p-button{width:100%;min-height:42px}.heartbeat-detail{align-items:flex-start;flex-direction:column}.heartbeat-detail .p-button{width:100%;min-height:42px}.store-feedback{margin-inline:14px}.tracking-destination-list{padding:0 14px 14px}.tracking-destination-head{align-items:flex-start;flex-wrap:wrap;padding:11px}.tracking-destination-copy{min-width:calc(100% - 42px);flex:1}.tracking-destination-head>.p-badge{margin-left:42px}.tracking-configure-button{margin-left:auto}.tracking-credential-grid{grid-template-columns:1fr;gap:9px}.tracking-credential-grid input{height:42px;font-size:12px}.tracking-editor-footer{align-items:flex-start;flex-direction:column}.tracking-editor-footer>div{width:100%;justify-content:space-between}.tracking-editor-footer button:not(.toggle){min-height:40px;flex:1}.section-title:has(.event-add-control){display:block}.section-title:has(.event-add-control) .event-add-control{width:100%;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px;margin-top:12px}.event-add-control input{width:100%;height:40px}.event-add-control .p-button{min-width:100px}.event-routing-table{margin-inline:14px;overflow:visible;border:0}.event-routing-header{display:none}.event-routing-row{display:grid;grid-template-columns:1fr 42px 42px 42px;gap:5px;min-height:84px;padding:11px 0;border:1px solid #e1e6e8;border-radius:6px;margin-bottom:8px}.event-routing-row>span:first-child{grid-column:1/-1;padding:0 11px}.event-routing-row>span:first-child strong{font-size:12px}.route-checkbox{width:38px;height:38px;justify-self:end;border:1px solid #e1e6e8;border-radius:5px;background:#f8faf9}.event-routing-row>.p-badge{grid-column:1/-1;justify-self:start;margin-left:11px}.tracking-routing-note{margin-inline:14px}.campaign-tool-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin:0 0 12px;padding:3px;background:#edf1f1;border:0;border-radius:7px}.campaign-tool-tabs button{min-width:0;height:38px;padding:0 5px;border:0!important;border-radius:5px;font-size:10px}.campaign-tool-tabs button.active{background:#fff;box-shadow:0 1px 2px rgba(23,33,43,.12)}.campaign-form,.campaign-event-form{grid-template-columns:1fr;padding:0 14px 14px;gap:10px}.campaign-form .span-2{grid-column:auto}.campaign-form input,.campaign-form select,.custom-field-row input{height:42px;font-size:12px}.campaign-link-actions{margin-inline:14px}.campaign-link-actions .p-button{flex:1}.url-parameter-list,.campaign-sandbox-banner,.custom-field-block,.campaign-empty,.test-response,.campaign-test-history,.campaign-preview-summary,.payload-preview,.preview-check-list,.latest-delivery{margin-left:14px;margin-right:14px}.campaign-preview-summary{grid-template-columns:1fr 1fr}.campaign-sandbox-banner{align-items:flex-start}.campaign-sandbox-banner>.p-badge{display:none}.custom-field-row{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr) 42px}.custom-field-row button{width:42px;height:42px}.payload-preview pre{max-height:360px;font-size:9px}.preview-panel{min-height:auto}}
