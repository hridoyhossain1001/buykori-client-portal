.preview-notice{display:flex;align-items:center;gap:10px;margin:-10px 0 24px;padding:10px 12px;color:#43515a;background:#f0f5f4;border:1px solid #d6e4e0;border-radius:6px;font-size:11px}.preview-notice strong{flex:0 0 auto;color:#155f51}.preview-notice span{line-height:1.45}

@media(max-width:760px){.preview-notice{align-items:flex-start;margin:-6px 0 20px}.preview-notice span{font-size:10px}.metric-strip,.settings-nav,.section-tabs,.view-tabs{background-image:linear-gradient(to right,transparent calc(100% - 22px),rgba(23,33,43,.12));background-attachment:local;background-position:right;background-repeat:no-repeat}.p-button,.icon-button,.settings-nav button,.section-tabs button,.view-tabs button,.row-actions button{min-height:44px}.icon-button{min-width:44px}.mobile-order-list article{cursor:pointer}.mobile-order-list article footer{min-height:32px}}

.drawer-edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:2px}.drawer-edit-grid label,.product-edit-row{display:grid;gap:4px;color:#74808a;font-size:9px;font-weight:700}.drawer-edit-grid label.full{grid-column:1/-1}.drawer-edit-grid input,.product-edit-row input{width:100%;height:34px;padding:0 8px;color:#27343c;background:#fff;border:1px solid #d7dcdf;border-radius:5px;font-size:10px}.product-edit-row{grid-template-columns:1fr 60px 34px;align-items:center;margin:5px 0}.event-destinations{display:flex;flex-wrap:wrap;gap:4px}.event-destinations .p-badge{font-size:8px}.analytics-breakdown{padding:0 20px 20px}.breakdown-rows{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.breakdown-rows div{padding:12px;background:#f7faf9;border:1px solid #e2ece9;border-radius:6px}.breakdown-rows span,.breakdown-rows strong,.breakdown-rows small{display:block}.breakdown-rows span{color:#74818a;font-size:9px;text-transform:uppercase}.breakdown-rows strong{margin-top:7px;font-size:15px}.breakdown-rows small{margin-top:4px;color:#7b8790;font-size:9px}.settings-section-tabs{margin-bottom:18px}.settings-section-tabs button{display:inline-flex;align-items:center;gap:7px;min-height:42px;padding:0 13px}.settings-content-wide{min-width:0}.connection-health-grid,.alert-delivery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;padding:0 20px 20px}.connection-health-grid>div,.alert-delivery-grid>div{display:grid;gap:5px;padding:12px;background:#f8faf9;border:1px solid #e1e9e7;border-radius:6px}.connection-health-grid span,.alert-delivery-grid span{color:#74818a;font-size:9px}.connection-health-grid strong,.alert-delivery-grid strong{font-size:11px}.connection-health-grid .p-badge{width:max-content}.alert-delivery-grid{grid-template-columns:1fr 1fr}.alert-delivery-grid small{color:#7b8790;font-size:9px}.plan-options{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:0 20px 20px}.plan-options>div{position:relative;display:grid;gap:6px;padding:14px;background:#fafbfb;border:1px solid #e1e6e8;border-radius:6px}.plan-options>div.selected{border-color:#8acbb9;background:#f0f8f5}.plan-options strong{font-size:14px}.plan-options span,.plan-options small{color:#708089;font-size:10px}.plan-options .p-badge{position:absolute;top:10px;right:10px}.support-topics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:0 20px 20px}.support-topics button{min-height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;color:#33434d;text-align:left;background:#fafbfb;border:1px solid #e1e6e8;border-radius:6px;font-size:10px;font-weight:700}.support-topics button:hover{background:#f1f7f5}
@media(max-width:760px){.drawer-edit-grid{grid-template-columns:1fr}.drawer-edit-grid label.full{grid-column:auto}.product-edit-row{grid-template-columns:1fr 56px 44px}.breakdown-rows,.connection-health-grid,.alert-delivery-grid,.plan-options,.support-topics{grid-template-columns:1fr}.settings-section-tabs{margin-inline:-3px}.settings-section-tabs button{min-width:max-content}.event-destinations{max-width:120px}}

/* Order drawer action hierarchy: primary workflow first, store link secondary. */
.order-drawer>footer{grid-template-columns:1fr}
.order-primary-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.order-primary-actions .p-button{min-height:44px}
.order-secondary-action{width:100%;min-height:38px!important;color:#53616a;background:#f8faf9;border-color:#dfe5e3}
@media(max-width:760px){.order-primary-actions{grid-template-columns:1fr 1fr}.order-primary-actions .p-button{min-width:0;padding-inline:8px}.order-secondary-action{min-height:42px!important}}

/* COD review rows keep decision context visible without pushing actions off-canvas. */
.cod-panel .table-wrap{overflow-x:auto}
.cod-panel .table-wrap table{width:100%;min-width:0;table-layout:fixed;border-collapse:collapse}
.cod-panel .table-wrap th,.cod-panel .table-wrap td{padding:11px 12px;vertical-align:middle;line-height:1.35;white-space:normal}
.cod-panel .table-wrap th{color:#64727c;font-size:11px;font-weight:700;letter-spacing:.02em;text-transform:uppercase;text-align:left}
.cod-panel .table-wrap tbody tr{height:72px}
.cod-panel .table-wrap tbody tr:hover{background:#f8faf9}
