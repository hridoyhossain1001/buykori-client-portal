@media(max-width:760px){.delivery-panel .provider-health{padding-inline:14px}.delivery-toolbar .toggle-label{margin-left:0}.delivery-toolbar .queue-count{margin-left:0;text-align:right}.delivery-mobile-list{display:grid}.delivery-mobile-list article{min-height:0}.delivery-mobile-list article>div strong{font-size:var(--type-caption)}.delivery-mobile-list article p{margin:12px 0}.delivery-mobile-list article p strong{overflow:hidden;font-size:var(--type-caption);text-overflow:ellipsis;white-space:nowrap}.delivery-mobile-list article p span{font-size:var(--type-label)}.delivery-mobile-list article footer{display:grid;grid-template-columns:1fr 1fr 18px;gap:8px;font-size:var(--type-label)}.delivery-mobile-list article footer span:nth-child(2){text-align:center}}

/* Setup health is a compact diagnostic workspace with explicit impact and actions. */
.setup-health-panel,.setup-health-panel button{font-family:Inter,Arial,sans-serif}.setup-health-panel .section-title{padding-bottom:14px}.health-list-summary{min-height:48px;display:flex;align-items:center;gap:22px;padding:0 16px;color:#66747d;background:#f8faf9;border-top:1px solid #edf0f1;border-bottom:1px solid #edf0f1;font-size:var(--type-label);line-height:1.4}.health-list-summary span{display:flex;align-items:baseline;gap:5px}.health-list-summary strong{color:#25323b;font-size:var(--type-caption)}.health-list-summary small{margin-left:auto;color:#7d8991;font-size:var(--type-label)}.health-list-header,.setup-health-panel .health-list article{display:grid;grid-template-columns:42px minmax(250px,1fr) minmax(190px,260px) 190px;align-items:center;gap:14px;padding-inline:16px}.health-list-header{min-height:38px;color:#687680;background:#fff;border-bottom:1px solid #edf0f1;font-size:var(--type-label);font-weight:700;line-height:1.35;text-transform:uppercase}.setup-health-panel .health-list article{min-height:104px;padding-block:13px}.setup-health-panel .health-list article.resolved{background:#f8fbfa}.setup-health-panel .health-list article.resolved .health-icon{color:#176b5b;background:#e8f5ef}.setup-health-panel .health-icon{width:36px;height:36px}.health-issue-copy{min-width:0}.health-issue-copy>div{display:flex;align-items:center;gap:7px}.health-issue-copy .p-badge{font-size:10px;line-height:1.2}.health-issue-copy .platform-label{margin:0;color:#74818a;font-size:10px;line-height:1.35}.setup-health-panel .health-list article h3{margin:6px 0 0;color:#25323b;font-size:var(--type-caption);font-weight:600;line-height:1.4}.setup-health-panel .health-list article p{margin:4px 0 0;color:#71808a;font-size:var(--type-label);line-height:1.45}.health-impact{padding-left:14px;border-left:1px solid #e5e9ea}.health-impact>span{color:#7a8790;font-size:10px;font-weight:700;line-height:1.35;text-transform:uppercase}.health-impact p{max-width:230px!important;color:#53616a!important