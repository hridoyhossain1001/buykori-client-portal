.tracking-editor-footer button:not(.toggle){min-height:32px;padding:0 9px;color:#176b5b;background:#fff;border:1px solid #cfe2dc;border-radius:5px;font-size:10px;font-weight:700}.event-add-control{display:flex;align-items:center;gap:7px}.event-add-control input{width:150px;height:34px}.event-routing-table{margin:0 20px 14px;overflow:hidden;border:1px solid #e1e6e8;border-radius:7px}.event-routing-header,.event-routing-row{display:grid;grid-template-columns:minmax(180px,1fr) 105px 105px 105px 115px;align-items:center;gap:8px}.event-routing-header{min-height:38px;padding:0 12px;color:#74818a;background:#f8faf9;border-bottom:1px solid #e1e6e8;font-size:9px;font-weight:800;text-transform:uppercase}.event-routing-header span:not(:first-child){text-align:center}.event-routing-row{min-height:57px;padding:8px 12px;border-bottom:1px solid #edf0f1}.event-routing-row:last-child{border-bottom:0}.event-routing-row>span:first-child strong,.event-routing-row>span:first-child small{display:block}.event-routing-row>span:first-child strong{font-size:11px}.event-routing-row>span:first-child small{margin-top:3px;color:#7b8790;font-size:9px}.route-checkbox{display:grid;place-items:center}.route-checkbox input{position:absolute;opacity:0}.route-checkbox i{width:18px;height:18px;display:block;border:1px solid #c7d3d1;border-radius:4px;background:#fff}.route-checkbox input:checked+i{background:var(--accent);border-color:var(--accent);box-shadow:inset 0 0 0 4px #fff}.event-routing-row>.p-badge{justify-self:end}.tracking-routing-note{display:flex;align-items:flex-start;gap:8px;margin:0 20px 14px;padding:10px 12px;color:#315b52;background:#f1f8f6;border:1px solid #d5eae4;border-radius:6px}.tracking-routing-note strong,.tracking-routing-note small{display:block}.tracking-routing-note strong{font-size:10px}.tracking-routing-note small{margin-top:3px;color:#71847f;font-size:9px}
.campaign-tool-tabs{margin-bottom:14px}.campaign-form{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 20px 18px;font-family:Inter,Arial,sans-serif}.campaign-form label{display:grid;gap:6px;color:#53616a;font-size:10px;font-weight:700}.campaign-form .span-2{grid-column:1/-1}.campaign-form input,.campaign-form select,.custom-field-row input{width:100%;height:38px;padding:0 10px;color:#26343d;background:#fff;border:1px solid #d7dcdf;border-radius:6px;font:500 11px/1 Inter,Arial,sans-serif;outline:none}.campaign-form input:focus,.campaign-form select:focus,.custom-field-row input:focus{border-color:#4d9587;box-shadow:0 0 0 3px rgba(42,124,107,.1)}.campaign-form .optional{color:#87939b;font-size:9px;font-weight:600}.campaign-link-actions{display:flex;gap:8px;margin:0 20px 14px}.campaign-link-actions .p-button{margin:0}.link-preview.ready{color:#315b52;background:#f4faf8;border-style:solid}.url-parameter-list{margin:0 20px 2px;border-top:1px solid #edf0f1}.url-parameter-list>div{display:grid;grid-template-columns:105px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid #edf0f1}.url-parameter-list span{color:#7b8790;font-size:10px}.url-parameter-list strong{overflow-wrap:anywhere;color:#3d4b54;font-size:11px}.campaign-test-grid,.campaign-preview-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:16px}.campaign-event-form{grid-template-columns:1fr 1fr}.campaign-sandbox-banner{display:flex;align-items:center;gap:9px;margin:0 20px 16px;padding:10px 12px;color:#315b52;background:#f1f8f6;border:1px solid #d5eae4;border-radius:6px}.campaign-sandbox-banner>span{min-width:0;flex:1}.campaign-sandbox-banner strong,.campaign-sandbox-banner small{display:block}.campaign-sandbox-banner strong{font-size:11px}.campaign-sandbox-banner small{margin-top:2px;color:#71847f;font-size:10px}.custom-field-block{margin:0 20px 16px;padding-top:13px;border-top:1px solid #edf0f1}.custom-field-block>div:first-child{display:flex;align-items:center;justify-co