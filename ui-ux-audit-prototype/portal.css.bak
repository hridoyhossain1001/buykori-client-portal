/* Plan & billing prototype: truthful limits, compact comparison, and payment context */
.plan-note{margin:0 20px 14px;padding:10px 12px;color:#61736e;background:#f5faf8;border:1px solid #dcece7;border-radius:6px;font-size:9px;line-height:1.5}.plan-compare-table{padding:0 20px 20px}.plan-compare-head,.plan-compare-row{display:grid;grid-template-columns:1.05fr 1fr 1.25fr 2.2fr 130px;gap:12px;align-items:center}.plan-compare-head{padding:0 12px 8px;color:#849098;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.plan-compare-row{min-height:70px;padding:11px 12px;border-top:1px solid #edf0f1}.plan-compare-row.selected{background:#f2faf7;border:1px solid #bfe3d7;border-radius:6px}.plan-compare-row strong{display:flex;align-items:center;gap:6px;font-size:11px}.plan-compare-row span{font-size:10px;font-weight:700;color:#34424b}.plan-compare-row small{color:#6e7d85;font-size:9px;line-height:1.45}.plan-compare-row .p-button{min-height:32px;padding:0 8px;font-size:9px}.billing-record{min-height:58px}.billing-help-list{padding:0 20px 20px}.billing-help-list>div{padding:11px 0;border-top:1px solid #edf0f1}.billing-help-list strong,.billing-help-list small{display:block}.billing-help-list strong{font-size:11px}.billing-help-list small{margin-top:4px;color:#7d8991;font-size:9px;line-height:1.5}
@media(max-width:760px){.plan-compare-table{padding-inline:14px}.plan-compare-head{display:none}.plan-compare-row{grid-template-columns:1fr auto;gap:6px 10px;min-height:0;padding:13px 11px;margin-bottom:8px;border:1px solid #e1e6e8;border-radius:6px}.plan-compare-row.selected{border-color:#bfe3d7}.plan-compare-row strong{grid-column:1}.plan-compare-row>span{grid-column:2;grid-row:1}.plan-compare-row small{grid-column:1/-1}.plan-compare-row .p-button{grid-column:1/-1;width:100%;min-height:38px;margin-top:3px}.billing-help-list{padding-inline:14px}}

/* Campaign tools prototype: compact connected workflow */
