@media(max-width:1100px){.portal-sidebar{width:220px}.portal-workspace{margin-left:220px}.portal-main{padding-inline:22px}.metric-strip{grid-template-columns:repeat(2,1fr)}.metric-strip>div:nth-child(2){border-right:0}.metric-strip>div:first-child{padding-left:20px}.metric-strip>div:nth-child(-n+2){border-bottom:1px solid var(--line)}.platform-rows button{grid-template-columns:35px 1fr 80px 80px 80px 80px 16px}.settings-layout{grid-template-columns:190px 1fr}}
@media(max-width:760px){.portal-sidebar{transform:translateX(-100%);width:min(284px,86vw);transition:transform .2s}.portal-sidebar.open{transform:translateX(0)}.sidebar-close{display:inline-grid!important}.nav-scrim{position:fixed;inset:0;z-index:25;display:block;background:rgba(17,28,36,.4);border:0}.portal-workspace{margin-left:0}.portal-topbar{height:56px;padding:0 14px}.mobile-menu{display:inline-grid}.crumbs{margin-right:auto}.crumbs span,.crumbs svg{display:none}.workspace-search{width:36px;padding:0;justify-content:center;background:transparent;border:0}.workspace-search span,.workspace-search kbd{display:none}.avatar-button{display:none}.portal-main{padding:24px 14px 40px}.page-heading{align-items:flex-start;margin-bottom:20px}.page-heading h1{font-size:26px}.page-heading p:not(.eyebrow){max-width:270px;line-height:1.5}.heading-actions .p-button:first-child{display:none}.heading-actions .p-button:last-child{width:38px;padding:0;font-size:0}.heading-actions .p-button:last-child svg{width:17px}.metric-strip{display:flex;margin:0 -14px 20px;padding:0 14px 12px;overflow-x:auto;border-top:0;scrollbar-width:none}.metric-strip::-webkit-scrollbar{display:none}.metric-strip>div{min-width:156px;min-height:82px;padding:13px 16px;background:#fff;border:1px solid var(--line)!important;border-right:0!important}.metric-strip>div:first-child{padding-left:16px;border-radius:7px 0 0 7px}.metric-strip>div:last-child{border-right:1px solid var(--line)!important;border-radius:0 7px 7px 0}.metric-strip strong{font-size:18px}.dashboard-grid,.analytics-grid,.ai-grid,.account-grid,.setup-grid,.builder-grid{grid-template-columns:1fr}.span-2{grid-column:auto}.p-panel{border-radius:7px}.platform-rows button{grid-template-columns:35px 1fr 70px 16px}.platform-rows button>span:nth-child(4),.platform-rows button>span:nth-child(5),.platform-rows button>.p-badge{display:none}.toolbar,.filter-row{align-items:stretch;flex-direction:column;gap:9px;padding:12px 14px}.field-search{width:100%}.too